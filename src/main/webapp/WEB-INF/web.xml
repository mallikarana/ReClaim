<?xml version="1.0" encoding="UTF-8"?>
<!--
    ReClaim deployment descriptor (Jakarta Servlet 6.0 / Tomcat 10.1).

    Servlets are registered with @WebServlet annotations on each controller.
    Filters are declared here instead, because web.xml is the only standard
    way to guarantee the ORDER in which filters run.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>ReClaim - Campus Lost &amp; Found</display-name>

    <!-- Read form data and write pages as UTF-8 (supports Hindi names, symbols, etc.) -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Optional: absolute folder for uploaded photos. Empty = <tomcat>/reclaim-uploads -->
    <context-param>
        <param-name>reclaim.uploadDir</param-name>
        <param-value></param-value>
    </context-param>

    <!-- ===== Filters (run in this order) ===== -->
    <!-- 1. Security headers on every response -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.reclaim.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <!-- 2. Login check: only public pages are reachable without a session -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.reclaim.filter.AuthFilter</filter-class>
    </filter>
    <!-- 3. CSRF token check on every POST -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.reclaim.filter.CsrfFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ===== Session handling ===== -->
    <session-config>
        <session-timeout>30</session-timeout> <!-- minutes of inactivity -->
        <cookie-config>
            <http-only>true</http-only>      <!-- JavaScript cannot read the session cookie -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode> <!-- never put the session id in URLs -->
    </session-config>

    <!-- ===== JSP settings ===== -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <!-- ===== Friendly error pages ===== -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <exception-type>com.reclaim.exception.DataAccessException</exception-type>
        <location>/WEB-INF/views/error/database.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
</web-app>
