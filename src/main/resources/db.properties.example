# Copy this file to db.properties (same folder) and fill in your values.
# db.properties is git-ignored so real passwords are never committed.
#
# Each value can also be overridden with an environment variable:
#   RECLAIM_DB_URL, RECLAIM_DB_USER, RECLAIM_DB_PASSWORD
db.url=jdbc:mysql://127.0.0.1:3306/reclaim_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&characterEncoding=UTF-8
db.user=reclaim_app
db.password=CHANGE_ME_PASSWORD
